{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Open World",
  "version": "0.1.0",
  "identifier": "io.hotamago.myopenworld",
  "build": {
    "beforeDevCommand": "pnpm --filter web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter web build",
    "frontendDist": "../../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "My Open World",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "appimage", "deb"],
    "icon": ["icons/icon.png"]
  }
}
